<UserControl x:Class="DoryNative.Games.PinballControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#030712" Focusable="True">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" BorderBrush="#1E3A8A" BorderThickness="0,0,0,1" Padding="2,1">
            <Menu Background="#0F172A" Foreground="#38BDF8" BorderThickness="0" FontFamily="Tahoma">
                <MenuItem Header="_Game" Foreground="#38BDF8" FontSize="11">
                    <MenuItem Header="_New Game" Click="NewGame_Click" InputGestureText="F2"/>
                    <MenuItem Header="_Pause / Resume" Click="Pause_Click" InputGestureText="F3"/>
                    <MenuItem Header="_High Scores..." Click="HighScores_Click"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Help" Foreground="#38BDF8" FontSize="11">
                    <MenuItem Header="_About 3D Pinball" Click="About_Click"/>
                </MenuItem>
            </Menu>
        </Border>
        <Grid>
            <Canvas x:Name="Table" Width="560" Height="420" Background="#030712"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas.Effect>
                    <DropShadowEffect Color="#0064FF" BlurRadius="20" ShadowDepth="0" Opacity="0.35"/>
                </Canvas.Effect>
            </Canvas>
            <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,8"
                        Orientation="Horizontal">
                <TextBlock Text="SPACE: Plunger  " Foreground="#38BDF8" FontFamily="Consolas" FontSize="10"/>
                <TextBlock Text="Z/◀: Left Flipper  " Foreground="#38BDF8" FontFamily="Consolas" FontSize="10"/>
                <TextBlock Text="/ /▶: Right Flipper  " Foreground="#38BDF8" FontFamily="Consolas" FontSize="10"/>
                <TextBlock Text="F2: New Game" Foreground="#38BDF8" FontFamily="Consolas" FontSize="10"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
