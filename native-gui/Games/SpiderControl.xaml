<UserControl x:Class="DoryNative.Games.SpiderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#008000">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#C0C0C0" Padding="2,1">
            <Menu Background="#C0C0C0" BorderThickness="0" FontFamily="Tahoma">
                <MenuItem Header="_Game" FontSize="11">
                    <MenuItem Header="_Deal" Click="Deal_Click" InputGestureText="F2"/>
                    <MenuItem Header="_Undo" Click="Undo_Click"/>
                    <Separator/>
                    <MenuItem Header="_1 Suit" Click="Suit1_Click" IsChecked="True"/>
                    <MenuItem Header="_2 Suits" Click="Suit2_Click"/>
                    <Separator/>
                    <MenuItem Header="E_xit" Click="Exit_Click"/>
                </MenuItem>
                <MenuItem Header="_Help" FontSize="11">
                    <MenuItem Header="_About Spider Solitaire" Click="About_Click"/>
                </MenuItem>
            </Menu>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#ECE9D8" BorderBrush="#716F64" BorderThickness="0,1,0,0" Padding="8,2">
            <DockPanel>
                <TextBlock x:Name="ScoreText" Text="Score: 500  |  Moves: 0" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock Text="Windows XP Spider Solitaire" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas x:Name="Board" Background="#008000" Margin="12"/>
        </ScrollViewer>
    </DockPanel>
</UserControl>
