<Window x:Class="WLMRevivalV2Desktop.Views.WinksPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Winks" Height="260" Width="320"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="False"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>
        <Style x:Key="WinkItem" TargetType="Border">
            <Setter Property="Width" Value="56"/>
            <Setter Property="Height" Value="56"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Background" Value="#FFF8FAFC"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FFD4E1EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="5" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="8" ShadowDepth="0" Opacity="0.4"/>
        </Border.Effect>
        <Border CornerRadius="4" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header without title bar -->
                <Border Grid.Row="0" Background="#FFF4F8FC" BorderBrush="#FFD4E1EE" BorderThickness="0,0,0,1" Padding="8,6"/>

                <!-- Content -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Featured winks" FontSize="11" FontWeight="SemiBold"
                                       Foreground="#FF1A1A1A"/>
                            <TextBlock Text="See more offerings" FontSize="10" Foreground="#FF1F6FC4"
                                       Cursor="Hand" Margin="8,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="TextDecorations" Value="Underline"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>

                        <WrapPanel x:Name="FeaturedWinksPanel" Margin="0,0,0,8">
                            <!-- Featured winks will be added in code -->
                        </WrapPanel>

                        <TextBlock Text="Recently used" FontSize="10"
                                   Foreground="#FF5A6B7B" Margin="0,0,0,4"/>
                        <WrapPanel x:Name="RecentWinksPanel">
                            <!-- Recent winks will be added in code -->
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Border>
</Window>
