<Window x:Class="WLMRevivalV2Desktop.Views.ContactNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Live Messenger" Height="120" Width="280"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        Topmost="True">

    <Border CornerRadius="7" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Height="24" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="/Assets/wlm/background.jpg" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    <Rectangle Fill="{StaticResource WlmGlassSheenBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Image Source="/Assets/wlm/wlm_logo.png" Width="14" Height="14" Margin="0,0,6,0"/>
                        <TextBlock Text="Windows Live Messenger" Foreground="#FF1C3E63" FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Style="{StaticResource WlmCaptionCloseButton}" ToolTip="Close" Click="Close_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,4,0" Width="20" Height="18">
                        <Path Data="M0,0 L7,7 M7,0 L0,7" Stroke="#FF1C3E63" StrokeThickness="1.6"/>
                    </Button>
                </Grid>

                <!-- Content -->
                <Grid Margin="10,15,10,2" Grid.RowSpan="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="83"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <!-- Avatar -->
                    <Grid Grid.Column="0" Margin="0,13,11,13">
                        <Image x:Name="ContactFrame" Source="/Assets/wlm/status_frame_online_small.png"
                               Stretch="Fill" Panel.ZIndex="0"/>
                        <Border Width="46" Height="46" CornerRadius="2" Panel.ZIndex="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,64,64" RadiusX="2" RadiusY="2"/>
                            </Border.Clip>
                            <Image x:Name="ContactTile" Source="/Assets/wlm/usertile_default.png" Stretch="Fill" Margin="0,0,0,0" RenderTransformOrigin="0.63,0.625"/>
                        </Border>
                    </Grid>

                    <!-- Message -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Height="52">
                        <TextBlock x:Name="ContactNameText" Text="Contact Name" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1A1A1A"/>
                        <TextBlock x:Name="StatusText" Text="has just signed in." FontSize="11"
                                   Foreground="#FF5A6B7B" Margin="0,2,0,0"/>
                        <TextBlock Text="Options" FontSize="11" Foreground="#FF1F6FC4"
                                   Cursor="Hand" Margin="0,4,0,0" HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="TextDecorations" Value="Underline"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Border>
</Window>
