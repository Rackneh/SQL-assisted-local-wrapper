<Window x:Class="WLMRevivalV2Desktop.Views.ChatWindowLive"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Conversation" Height="560" Width="560"
        MinWidth="460" MinHeight="420"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Labelled toolbar button with optional dropdown caret (Wave 4) -->
        <Style x:Key="LiveBarButton" TargetType="Button" BasedOn="{StaticResource WlmIconButton}">
            <Setter Property="Padding" Value="5,2"/>
        </Style>
    </Window.Resources>

    <!-- ===== Flat Wave-4 window frame ===== -->
    <Border CornerRadius="4" Background="White" BorderThickness="1" BorderBrush="#FF8FA8BE"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#66000000" BlurRadius="10" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="3" ClipToBounds="True" Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Wink fullscreen overlay: covers the whole window content when a wink plays. -->
                <Border x:Name="WinkOverlay"
                       Grid.Row="0" Grid.RowSpan="3"
                       Background="#E6000000"
                       Visibility="Collapsed"
                       Panel.ZIndex="100"
                       MouseLeftButtonDown="WinkOverlay_Click">
                    <Image x:Name="WinkOverlayImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
                </Border>

                <!-- ===== Header: sky gradient band, contact DP left, name right ===== -->
                <Grid Grid.Row="0" Height="108" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <!-- color-scheme banner background -->
                    <Border VerticalAlignment="Top" Height="108" IsHitTestVisible="False">
                        <Border.Background>
                            <ImageBrush ImageSource="{DynamicResource WlmBannerImage}" Stretch="UniformToFill" AlignmentY="Top"/>
                        </Border.Background>
                    </Border>

                    <!-- contact-specific banner (fetched from server). Sits on top
                         of the colour-scheme band above and fades out towards the
                         right along a slanted edge, so the contact's colour shows
                         through on the right and below the banner. -->
                    <Border x:Name="ContactBanner" Visibility="Collapsed" VerticalAlignment="Top" Height="108" IsHitTestVisible="False">
                        <Border.Background>
                            <ImageBrush x:Name="ContactBannerBrush" Stretch="UniformToFill" AlignmentY="Top"/>
                        </Border.Background>
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.5">
                                <GradientStop Color="#FFFFFFFF" Offset="0.0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.5"/>
                                <GradientStop Color="#00FFFFFF" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <!-- hidden scene elements (shared background-picker code path) -->
                    <Border x:Name="ChatHeaderScene" Visibility="Collapsed" Height="108" VerticalAlignment="Top">
                        <Image x:Name="ChatHeaderSceneImage" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    </Border>

                    <!-- caption buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,3,4,0">
                        <Button Style="{StaticResource WlmCaptionButton}" ToolTip="Minimize" Click="Minimize_Click">
                            <Path Data="M0,5 L9,5" Stroke="#FF44586B" StrokeThickness="1.6"/>
                        </Button>
                        <Button Style="{StaticResource WlmCaptionButton}" ToolTip="Maximize" Click="Maximize_Click" Margin="2,0,0,0">
                            <Path Data="M0,0 L9,0 L9,8 L0,8 Z" Stroke="#FF44586B" StrokeThickness="1.3" Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource WlmCaptionCloseButton}" ToolTip="Close" Click="Close_Click" Margin="2,0,0,0">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#FF44586B" StrokeThickness="1.6"/>
                        </Button>
                    </StackPanel>

                    <!-- contact DP + name/status -->
                    <Grid VerticalAlignment="Top" Margin="10,8,0,0" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <Grid Width="88" Height="88">
                                <Image x:Name="ContactStatusFrame" Source="/Assets/wlm/status_frame_online_large.png"
                                       Stretch="Fill" Panel.ZIndex="0" Margin="-3,0,-3,0"/>
                                <Border Width="66" Height="66" CornerRadius="2" Panel.ZIndex="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border.Clip>
                                        <RectangleGeometry Rect="0,0,66,66" RadiusX="2" RadiusY="2"/>
                                    </Border.Clip>
                                    <Image x:Name="ContactTile" Source="/Assets/wlm/usertile_default.png" Stretch="UniformToFill"/>
                                </Border>
                            </Grid>
                            <!-- small webcam glyph under the DP -->
                            <Path Data="M2,4 L12,4 L12,12 L2,12 Z M12,6 L16,4 L16,12 L12,10 Z" Fill="#FF7BA7CC"
                                  Width="15" Height="11" Stretch="Uniform" Margin="6,4,0,0" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="10,8,0,0">
                            <TextBlock x:Name="ContactNameText" Text="Chat" FontSize="13" FontWeight="SemiBold"
                                       Foreground="#FF3B3B3B" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ContactStatusText" Text=" (Available)" FontSize="11"
                                       Foreground="#FF8A99A8" VerticalAlignment="Center" Margin="5,1,0,0"/>
                            <TextBlock x:Name="ContactPmText" Text="" FontSize="11" FontStyle="Italic"
                                       Foreground="#FF8A99A8" VerticalAlignment="Center" Margin="10,1,0,0"
                                       TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Body : left gutter (DPs) + transcript/compose ===== -->
                <Grid Grid.Row="1" x:Name="ConversationBackground" Background="White">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="106"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- own DP pinned bottom-left -->
                    <Grid Grid.Column="0" Width="88" Height="88" VerticalAlignment="Bottom"
                          HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Image x:Name="OwnStatusFrame" Source="/Assets/wlm/status_frame_online_large.png"
                               Stretch="Fill" Panel.ZIndex="0" Margin="-2,0,-2,0"/>
                        <Border Width="66" Height="66" CornerRadius="2" Panel.ZIndex="1"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,66,66" RadiusX="2" RadiusY="2"/>
                            </Border.Clip>
                            <Image x:Name="OwnTile" Source="/Assets/wlm/usertile_default.png" Stretch="UniformToFill"/>
                        </Border>
                    </Grid>

                    <!-- transcript + compose -->
                    <Grid Grid.Column="1" Margin="0,0,10,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- message history: borderless white -->
                        <ScrollViewer Grid.Row="0" x:Name="MessagesScroller" VerticalScrollBarVisibility="Auto"
                                      Background="Transparent">
                            <StackPanel x:Name="MessagesPanel" Margin="2,1"/>
                        </ScrollViewer>

                        <!-- last-message-received / typing status -->
                        <TextBlock x:Name="LastReceivedText" Grid.Row="1" Text="" FontSize="10"
                                   Foreground="#FF9AA7B3" HorizontalAlignment="Left" Margin="2,3,0,3"/>

                        <!-- input -->
                        <Border Grid.Row="2" Background="White" BorderBrush="#FFBFD3E6" BorderThickness="1"
                                CornerRadius="4" Padding="4">
                            <TextBox x:Name="MessageBox" Height="48" FontSize="13"
                                     BorderThickness="0" Background="White" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="MessageBox_PreviewKeyDown"/>
                        </Border>

                        <!-- Wave-4 toolbar BELOW the compose box -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0" Height="24">
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Emoticons" Click="Emoticon_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/wlm/select_emoticon.png" Width="20" Height="14"/>
                                    <Path Data="M0,0 L6,0 L3,4 Z" Fill="#FF6B7B8A" Margin="3,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Send a GIF" Click="Gif_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#FF3A6EA5" CornerRadius="2" Padding="3,0" VerticalAlignment="Center">
                                        <TextBlock Text="GIF" FontSize="10" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Share files and photos" Click="Share_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/wlm/mail.png" Width="16" Height="12"/>
                                    <TextBlock Text="Share" FontSize="11" Foreground="#FF3B5F87" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <Path Data="M0,0 L6,0 L3,4 Z" Fill="#FF6B7B8A" Margin="3,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Video call" Click="VideoCall_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,4 L13,4 L13,14 L2,14 Z M13,7 L19,4 L19,14 L13,11 Z" Fill="#FF3A6EA5"
                                          Width="16" Height="12" Stretch="Uniform"/>
                                    <TextBlock Text="Video call" FontSize="11" Foreground="#FF3B5F87" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <Path Data="M0,0 L6,0 L3,4 Z" Fill="#FF6B7B8A" Margin="3,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Winks" Click="Wink_Click">
                                <Image Source="/Assets/wlm/select_wink.png" Width="20" Height="13"/>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Games">
                                <TextBlock Text="Games" FontSize="11" Foreground="#FF3B5F87"/>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Nudge" Click="NudgeButton_Click">
                                <Image Source="/Assets/wlm/send_nudge.png" Width="17" Height="17"/>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Activities">
                                <StackPanel Orientation="Horizontal">
                                    <Image Source="/Assets/wlm/wlm_logo.png" Width="14" Height="14"/>
                                    <TextBlock Text="Activities" FontSize="11" Foreground="#FF3B5F87" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                    <Path Data="M0,0 L6,0 L3,4 Z" Fill="#FF6B7B8A" Margin="3,2,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Invite someone">
                                <Image Source="/Assets/wlm/add_contact.png" Width="18" Height="14"/>
                            </Button>
                            <Button x:Name="VoiceButton" Style="{StaticResource LiveBarButton}" ToolTip="Voice clip" Click="Voice_Click">
                                <Path Data="M12,3 C10.3,3 9,4.3 9,6 L9,12 C9,13.7 10.3,15 12,15 C13.7,15 15,13.7 15,12 L15,6 C15,4.3 13.7,3 12,3 Z M6,11 C6,14 8.5,16.5 11,16.8 L11,20 L13,20 L13,16.8 C15.5,16.5 18,14 18,11"
                                      Stroke="#FF3A6EA5" StrokeThickness="1.4" Fill="#FFBFD6EC"
                                      Width="16" Height="16" Stretch="Uniform"/>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Voice options" Click="VoiceOptions_Click" Width="14" Padding="2,0">
                                <Path Data="M0,0 L4,4 L8,0" Stroke="#FF3A6EA5" StrokeThickness="1.4" Fill="#FFBFD6EC"
                                      Width="8" Height="4" Stretch="Uniform" VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource LiveBarButton}" ToolTip="Change font" Click="Font_Click">
                                <TextBlock Text="&#187;" FontSize="13" FontWeight="Bold" Foreground="#FF6B7B8A"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== Bottom ad strip ===== -->
                <Border Grid.Row="2" Height="22" Background="#FFF4F7FA" BorderBrush="#FFE3EDF6" BorderThickness="0,1,0,0">
                    <TextBlock Text="Gain new skills and boost your career with the WLM Revival"
                               FontSize="10" Foreground="#FF8A99A8" VerticalAlignment="Center" Margin="8,0"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
