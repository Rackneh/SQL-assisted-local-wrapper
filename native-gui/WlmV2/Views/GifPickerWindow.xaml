<Window x:Class="WLMRevivalV2Desktop.Views.GifPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pick a GIF" Height="440" Width="380"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI"
        ShowInTaskbar="False">

    <Window.Resources>
        <!-- Wave-4 styled tab button -->
        <Style x:Key="GifTabButton" TargetType="ToggleButton">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#FF3B5F87"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" CornerRadius="3" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFEAF2FB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD7E8F8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="6" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="10" ShadowDepth="0" Opacity="0.45"/>
        </Border.Effect>
        <Border CornerRadius="5" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title / search bar -->
                <Border Grid.Row="0" Background="#FFF4F8FC" BorderBrush="#FFD4E1EE" BorderThickness="0,0,0,1"
                        Padding="8,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="White" BorderBrush="#FFBFD3E6" BorderThickness="1"
                                CornerRadius="3" Padding="5,0" VerticalAlignment="Center">
                            <Grid>
                                <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                         FontSize="12" Height="22" VerticalContentAlignment="Center"
                                         KeyDown="SearchBox_KeyDown"/>
                                <TextBlock x:Name="SearchPlaceholder" Text="Search Tenor for GIFs..."
                                           Foreground="#FFA7B4C2" FontSize="12" IsHitTestVisible="False"
                                           VerticalAlignment="Center" Margin="2,0,0,0"/>
                            </Grid>
                        </Border>
                        <Button Grid.Column="1" Content="Search" Click="SearchButton_Click"
                                Margin="6,0,0,0" Padding="10,0" Height="24" FontSize="12" Cursor="Hand"
                                Foreground="#FF1A1A1A"/>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="8,6,8,4">
                    <ToggleButton x:Name="TrendingTab" Content="Trending" Style="{StaticResource GifTabButton}"
                                  IsChecked="True" Click="TrendingTab_Click"/>
                    <ToggleButton x:Name="FavoritesTab" Content="Favourites" Style="{StaticResource GifTabButton}"
                                  Margin="4,0,0,0" Click="FavoritesTab_Click"/>
                </StackPanel>

                <!-- Results -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="6,0,6,0"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <WrapPanel x:Name="ResultsPanel" Orientation="Horizontal"/>
                        <TextBlock x:Name="StatusText" Text="Loading trending GIFs..."
                                   Foreground="#FF8A99A8" FontSize="12" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,20,12,0"
                                   TextAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </ScrollViewer>

                <!-- Footer -->
                <Border Grid.Row="3" Background="#FFF4F8FC" BorderBrush="#FFD4E1EE" BorderThickness="0,1,0,0"
                        Padding="8,5">
                    <Grid>
                        <TextBlock Text="Powered by Tenor" FontSize="10" Foreground="#FF9AA7B3"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="Close" FontSize="11" Foreground="#FF1F6FC4" Cursor="Hand"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   MouseLeftButtonDown="Close_Click"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
