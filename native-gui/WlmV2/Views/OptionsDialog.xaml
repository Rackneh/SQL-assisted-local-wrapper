<Window x:Class="WLMRevivalV2Desktop.Views.OptionsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Options" Height="500" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="WlmDialogButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                BorderBrush="#FF8CA8C4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFCFEFF" Offset="0"/>
                                    <GradientStop Color="#FFEDF3F9" Offset="0.5"/>
                                    <GradientStop Color="#FFDBE7F2" Offset="0.5"/>
                                    <GradientStop Color="#FFD0DEEC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8CC9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD0DEEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OptionsListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#FF1A1A1A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE3EEF8"/>
                                <Setter Property="Foreground" Value="#FF1C5FA8"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF0F5FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="7" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Height="29" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="/Assets/wlm/background.jpg" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    <Rectangle Fill="{StaticResource WlmGlassSheenBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Image Source="/Assets/wlm/wlm_logo.png" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Options" Foreground="#FF1C3E63" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource WlmCaptionCloseButton}" ToolTip="Close" Click="Close_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#FF1C3E63" StrokeThickness="1.6"/>
                    </Button>
                </Grid>

                <!-- Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left sidebar -->
                    <Border Grid.Column="0" Background="#FFF4F8FC" BorderBrush="#FFD4E1EE" BorderThickness="0,0,1,0">
                        <ListBox x:Name="OptionsList" BorderThickness="0" Background="Transparent"
                                 SelectionChanged="OptionsList_SelectionChanged">
                            <ListBoxItem Content="Personal" Style="{StaticResource OptionsListItem}" IsSelected="True"/>
                            <ListBoxItem Content="Layout" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Sign in" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Messages" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Alerts" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Sounds" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="File Transfer" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Privacy" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Security" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Connection" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="IBA" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="PIP" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Server" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Updates" Style="{StaticResource OptionsListItem}"/>
                            <ListBoxItem Content="Debug" Style="{StaticResource OptionsListItem}"/>
                        </ListBox>
                    </Border>

                    <!-- Right content area -->
                    <Border Grid.Column="1" Background="White" Padding="15">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ContentPanel"/>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- Buttons -->
                <Border Grid.Row="2" Background="#FFF4F8FC" BorderBrush="#FFD4E1EE" BorderThickness="0,1,0,0"
                         Padding="15">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="OK" Click="OkButton_Click"
                                 Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                        <Button Content="Cancel" Click="CancelButton_Click"
                                 Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                        <Button Content="Apply" Click="ApplyButton_Click"
                                 Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                        <Button Content="Help" Click="HelpButton_Click"
                                 Style="{StaticResource WlmDialogButton}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
