<Window x:Class="WLMRevivalV2Desktop.Views.SceneDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Scene" Height="480" Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="WlmDialogButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                BorderBrush="#FF8CA8C4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFCFEFF" Offset="0"/>
                                    <GradientStop Color="#FFEDF3F9" Offset="0.5"/>
                                    <GradientStop Color="#FFDBE7F2" Offset="0.5"/>
                                    <GradientStop Color="#FFD0DEEC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8CC9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD0DEEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SceneItem" TargetType="Border">
            <Setter Property="Width" Value="80"/>
            <Setter Property="Height" Value="60"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#FFB8C8D8"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="ColorItem" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderBrush" Value="#FFB8C8D8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border CornerRadius="7" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Height="29" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="/Assets/wlm/background.jpg" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    <Rectangle Fill="{StaticResource WlmGlassSheenBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Image Source="/Assets/wlm/select_background.png" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Scene" Foreground="#FF1C3E63" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource WlmCaptionCloseButton}" ToolTip="Close" Click="Close_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#FF1C3E63" StrokeThickness="1.6"/>
                    </Button>
                </Grid>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="15">
                    <TextBlock Text="The people you chat with will see the scene and color scheme you choose."
                               FontSize="11" Foreground="#FF5A6B7B" TextWrapping="Wrap" Margin="0,0,0,10"/>

                    <!-- Select a scene -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="/Assets/wlm/select_a_scene.png" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Select a scene" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1A1A1A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Height="200">
                        <WrapPanel x:Name="ScenesPanel">
                            <!-- Scenes will be added in code -->
                        </WrapPanel>
                    </ScrollViewer>

                    <Button x:Name="BrowseButton" Content="Browse..." Style="{StaticResource WlmDialogButton}"
                            HorizontalAlignment="Left" Margin="0,8,0,12" Height="24" Click="BrowseButton_Click"/>

                    <!-- Select a color scheme -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Image Source="/Assets/wlm/select_a_color_scheme.png" Width="20" Height="20" Margin="0,0,6,0"/>
                        <TextBlock Text="Select a color scheme" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#FF1A1A1A" VerticalAlignment="Center"/>
                    </StackPanel>

                    <WrapPanel x:Name="ColorsPanel" Margin="0,0,0,8">
                        <!-- Colors will be added in code -->
                    </WrapPanel>

                    <TextBlock Text="More colors..." FontSize="11" Foreground="#FF1F6FC4"
                               Cursor="Hand" Margin="0,0,0,10">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,15,15">
                    <Button Content="OK" Click="OkButton_Click"
                             Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                    <Button Content="Close" Click="CloseButton_Click"
                             Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                    <Button Content="Apply" Click="ApplyButton_Click"
                             Style="{StaticResource WlmDialogButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
