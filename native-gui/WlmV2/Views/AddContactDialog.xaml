<Window x:Class="WLMRevivalV2Desktop.Views.AddContactDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add a contact" Height="280" Width="420"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="WlmDialogButton" TargetType="Button">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                BorderBrush="#FF8CA8C4">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#FFFCFEFF" Offset="0"/>
                                    <GradientStop Color="#FFEDF3F9" Offset="0.5"/>
                                    <GradientStop Color="#FFDBE7F2" Offset="0.5"/>
                                    <GradientStop Color="#FFD0DEEC" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#FF1A1A1A"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8CC9"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFD0DEEC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="7" Background="White" BorderThickness="1" BorderBrush="#FF5B86B0"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#88000000" BlurRadius="12" ShadowDepth="0" Opacity="0.5"/>
        </Border.Effect>
        <Border CornerRadius="6" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0" Height="29" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Image Source="/Assets/wlm/background.jpg" Stretch="UniformToFill" VerticalAlignment="Top"/>
                    <Rectangle Fill="{StaticResource WlmGlassSheenBrush}"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                        <Image Source="/Assets/wlm/wlm_people.png" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock Text="Add a contact" Foreground="#FF1C3E63" FontSize="12"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Style="{StaticResource WlmCaptionCloseButton}" ToolTip="Close" Click="Close_Click"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,4,0">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="#FF1C3E63" StrokeThickness="1.6"/>
                    </Button>
                </Grid>

                <!-- Content -->
                <StackPanel Grid.Row="1" Margin="20,20,20,10">
                    <TextBlock Text="Add a contact to Windows Live Messenger to chat and share with them."
                               FontSize="12" Foreground="#FF5A6B7B" TextWrapping="Wrap" Margin="0,0,0,15"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Grid Grid.Column="0" Width="64" Height="64" Margin="0,0,15,0" VerticalAlignment="Top">
                            <Image Source="/Assets/wlm/status_frame_online_large.png" Stretch="Fill" Panel.ZIndex="0"/>
                            <Border Width="48" Height="48" CornerRadius="2" Panel.ZIndex="1"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border.Clip>
                                    <RectangleGeometry Rect="0,0,48,48" RadiusX="2" RadiusY="2"/>
                                </Border.Clip>
                                <Image Source="/Assets/wlm/wlm_people.png" Stretch="Uniform"/>
                            </Border>
                        </Grid>

                        <!-- Form -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Enter the email address of the contact you want to add:"
                                       FontSize="12" Foreground="#FF1A1A1A" Margin="0,0,0,6"/>
                            <TextBox x:Name="EmailTextBox" Height="24" FontSize="12"
                                     BorderBrush="#FFB8C8D8" BorderThickness="1" Padding="4,2"
                                     VerticalContentAlignment="Center"/>

                            <TextBlock Text="Enter an optional display name for this contact:"
                                       FontSize="12" Foreground="#FF1A1A1A" Margin="0,12,0,6"/>
                            <TextBox x:Name="DisplayNameTextBox" Height="24" FontSize="12"
                                     BorderBrush="#FFB8C8D8" BorderThickness="1" Padding="4,2"
                                     VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>

                <!-- Buttons -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                            Margin="0,0,15,15">
                    <Button Content="Add contact" Click="AddButton_Click"
                             Style="{StaticResource WlmDialogButton}" Margin="0,0,8,0"/>
                    <Button Content="Cancel" Click="CancelButton_Click"
                             Style="{StaticResource WlmDialogButton}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>
