<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

            <!-- Banner/header image, swapped at runtime by ColorSchemeManager.
                 Windows reference it via {DynamicResource WlmBannerImage}. -->
            <BitmapImage x:Key="WlmBannerImage" UriSource="/Assets/wlm/background.jpg"/>

            <!-- ===== WLM 2009 color palette (mirrors APK colors.xml) ===== -->
            <Color x:Key="WlmPrimaryColor">#FF2C6FB5</Color>
            <Color x:Key="WlmPrimaryDarkColor">#FF1C4E84</Color>
            <Color x:Key="WlmAccentColor">#FF2C82C9</Color>
            <Color x:Key="WlmBackgroundColor">#FFEAF1F8</Color>
            <Color x:Key="WlmWindowBgColor">#FFFFFFFF</Color>
            <Color x:Key="WlmTextPrimaryColor">#FF1A1A1A</Color>
            <Color x:Key="WlmTextSecondaryColor">#FF5A6B7B</Color>
            <Color x:Key="WlmTextHintColor">#FF9AA7B3</Color>
            <Color x:Key="WlmDividerColor">#FFD4E1EE</Color>
            <Color x:Key="WlmListBgColor">#FFF4F8FC</Color>
            <Color x:Key="WlmGroupHeaderColor">#FFDCE7F2</Color>
            <Color x:Key="WlmHeaderTopColor">#FFE6F1FB</Color>
            <Color x:Key="WlmHeaderMidColor">#FFCFE3F5</Color>
            <Color x:Key="WlmHeaderBottomColor">#FFBBD6EE</Color>
            <Color x:Key="WlmBorderColor">#FFA9C9E6</Color>
            <Color x:Key="WlmAvatarBorderColor">#FFB8C8D8</Color>

            <SolidColorBrush x:Key="WlmPrimaryBrush" Color="{StaticResource WlmPrimaryColor}"/>
            <SolidColorBrush x:Key="WlmPrimaryDarkBrush" Color="{StaticResource WlmPrimaryDarkColor}"/>
            <SolidColorBrush x:Key="WlmAccentBrush" Color="{StaticResource WlmAccentColor}"/>
            <SolidColorBrush x:Key="WlmBackgroundBrush" Color="{StaticResource WlmBackgroundColor}"/>
            <SolidColorBrush x:Key="WlmWindowBgBrush" Color="{StaticResource WlmWindowBgColor}"/>
            <SolidColorBrush x:Key="WlmTextPrimaryBrush" Color="{StaticResource WlmTextPrimaryColor}"/>
            <SolidColorBrush x:Key="WlmTextSecondaryBrush" Color="{StaticResource WlmTextSecondaryColor}"/>
            <SolidColorBrush x:Key="WlmTextHintBrush" Color="{StaticResource WlmTextHintColor}"/>
            <SolidColorBrush x:Key="WlmDividerBrush" Color="{StaticResource WlmDividerColor}"/>
            <SolidColorBrush x:Key="WlmListBgBrush" Color="{StaticResource WlmListBgColor}"/>
            <SolidColorBrush x:Key="WlmGroupHeaderBrush" Color="{StaticResource WlmGroupHeaderColor}"/>
            <SolidColorBrush x:Key="WlmBorderBrush" Color="{StaticResource WlmBorderColor}"/>
            <SolidColorBrush x:Key="WlmAvatarBorderBrush" Color="{StaticResource WlmAvatarBorderColor}"/>

            <!-- Glossy Aero header / chrome gradient -->
            <LinearGradientBrush x:Key="WlmAeroBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource WlmHeaderTopColor}" Offset="0"/>
                <GradientStop Color="{StaticResource WlmHeaderMidColor}" Offset="0.5"/>
                <GradientStop Color="{StaticResource WlmHeaderBottomColor}" Offset="1"/>
            </LinearGradientBrush>

            <!-- Near-white toolbar band (search row, chat format bar).
                 Recolored by ColorSchemeManager - reference via DynamicResource. -->
            <LinearGradientBrush x:Key="WlmToolbarBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFFBFDFE" Offset="0"/>
                <GradientStop Color="#FFF0F6FB" Offset="0.5"/>
                <GradientStop Color="#FFE4EEF7" Offset="1"/>
            </LinearGradientBrush>

            <!-- Pale Aero-blue tint that bathes the WHOLE contact-list body in
                 the original client (the list is never pure white). -->
            <LinearGradientBrush x:Key="WlmBodyTintBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFF6FAFE" Offset="0"/>
                <GradientStop Color="#FFE7F1FA" Offset="1"/>
            </LinearGradientBrush>

            <!-- Slightly deeper blue band (What's New / Novedades area). -->
            <LinearGradientBrush x:Key="WlmBandBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFDCE9F6" Offset="0"/>
                <GradientStop Color="#FFCFE2F3" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== Aero button ===== -->
            <Style x:Key="WlmAeroButton" TargetType="Button">
                <Setter Property="Foreground" Value="{DynamicResource WlmPrimaryDarkBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{DynamicResource WlmBorderBrush}"
                                    Background="{DynamicResource WlmAeroBrush}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource WlmAccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource WlmGroupHeaderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Primary call-to-action (Sign in) -->
            <Style x:Key="WlmPrimaryButton" TargetType="Button" BasedOn="{StaticResource WlmAeroButton}">
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{StaticResource WlmPrimaryDarkBrush}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FF5AA0DC" Offset="0"/>
                                        <GradientStop Color="#FF2C6FB5" Offset="0.5"/>
                                        <GradientStop Color="#FF1C4E84" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.92"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Borderless image icon button (toolbar / chat actions) -->
            <Style x:Key="WlmIconButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="Transparent" CornerRadius="3" Padding="3">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#55FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- WLM textbox -->
            <Style x:Key="WlmTextBox" TargetType="TextBox">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Foreground" Value="{StaticResource WlmTextPrimaryBrush}"/>
                <Setter Property="Padding" Value="6,3"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="{StaticResource WlmAvatarBorderBrush}"
                                    Background="{TemplateBinding Background}">
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource WlmAccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Group header (Online / Away / Offline) -->
            <Style x:Key="WlmGroupExpander" TargetType="Expander">
                <Setter Property="Foreground" Value="{DynamicResource WlmPrimaryDarkBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>

            <!-- Glossy silver Aero button (WLM 2009 "Sign in") -->
            <Style x:Key="WlmSilverButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FF1A1A1A"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Padding" Value="22,5"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="#FF8CA8C4">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFCFEFF" Offset="0"/>
                                        <GradientStop Color="#FFEDF3F9" Offset="0.5"/>
                                        <GradientStop Color="#FFDBE7F2" Offset="0.5"/>
                                        <GradientStop Color="#FFD0DEEC" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF4F8CC9"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFD0DEEC"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Blue hyperlink-style text -->
            <Style x:Key="WlmLink" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FF1F6FC4"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="TextDecorations" Value="{x:Null}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="TextDecorations" Value="Underline"/>
                        <Setter Property="Foreground" Value="#FF1559A8"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ===== Aero glass title-bar gradient (glossy translucent) ===== -->
            <LinearGradientBrush x:Key="WlmGlassBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFEAF3FB" Offset="0"/>
                <GradientStop Color="#FFCFE3F6" Offset="0.5"/>
                <GradientStop Color="#FFB9D6EF" Offset="0.51"/>
                <GradientStop Color="#FFCBE0F4" Offset="1"/>
            </LinearGradientBrush>

            <!-- Translucent white sheen overlaid on banner photos -->
            <LinearGradientBrush x:Key="WlmGlassSheenBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#88FFFFFF" Offset="0"/>
                <GradientStop Color="#33FFFFFF" Offset="0.5"/>
                <GradientStop Color="#00FFFFFF" Offset="0.5"/>
                <GradientStop Color="#22FFFFFF" Offset="1"/>
            </LinearGradientBrush>

            <!-- ===== Aero caption buttons (minimize / maximize) ===== -->
            <Style x:Key="WlmCaptionButton" TargetType="Button">
                <Setter Property="Width" Value="26"/>
                <Setter Property="Height" Value="20"/>
                <Setter Property="Foreground" Value="#FF1C3E63"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="#44FFFFFF" Background="#33FFFFFF">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#88FFFFFF"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FF9CC4E8"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFBFD9F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ===== Aero caption close button (red hover) ===== -->
            <Style x:Key="WlmCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource WlmCaptionButton}">
                <Setter Property="Width" Value="40"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="3" BorderThickness="1"
                                    BorderBrush="#44FFFFFF" Background="#33FFFFFF">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFE25C5C"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="#FFC23B3B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#FFB52E2E"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window control glyph button (min / close) -->
            <Style x:Key="WlmChromeButton" TargetType="Button">
                <Setter Property="Width" Value="22"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="Foreground" Value="#FF2C4A6B"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" Background="#33FFFFFF" CornerRadius="2" BorderThickness="1"
                                    BorderBrush="#55FFFFFF">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#66FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

</ResourceDictionary>
