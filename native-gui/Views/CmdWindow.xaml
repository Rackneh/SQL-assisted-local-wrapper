<UserControl x:Class="DoryNative.Views.CmdWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="350" Width="600">
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" x:Name="OutputScroll" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="OutputPanel" Margin="8,4">
                <TextBlock x:Name="WelcomeText" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13"
                           Foreground="White" Text="Microsoft Windows XP [Version 5.1.2600]&#x0a;(C) Copyright 1985-2001 Microsoft Corp.&#x0a;&#x0a;Type 'help' for a list of commands."/>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="1" Margin="8,0,8,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="PromptText" Text="C:\&gt;" FontFamily="Consolas"
                       FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox Grid.Column="1" x:Name="InputBox" FontFamily="Consolas" FontSize="13"
                     Background="Black" Foreground="White" BorderThickness="0" CaretBrush="White"
                     KeyDown="InputBox_KeyDown" AcceptsReturn="False"/>
        </Grid>
    </Grid>
</UserControl>
