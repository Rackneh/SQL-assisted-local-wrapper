<UserControl x:Class="DoryNative.Views.XpWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="300" Width="400">
    <Grid x:Name="FrameGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Luna frame: side + bottom borders -->
        <Image x:Name="FrameLeftImg" Grid.Row="0" Grid.RowSpan="2" Width="5"
               HorizontalAlignment="Left" Stretch="Fill" IsHitTestVisible="False"/>
        <Image x:Name="FrameRightImg" Grid.Row="0" Grid.RowSpan="2" Width="5"
               HorizontalAlignment="Right" Stretch="Fill" IsHitTestVisible="False"/>
        <Image x:Name="FrameBottomImg" Grid.Row="1" Height="10"
               VerticalAlignment="Bottom" Stretch="Fill" IsHitTestVisible="False"/>

        <!-- Resize handles -->
        <Thumb x:Name="ResizeSE" Grid.Row="1" Width="12" Height="12"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               Cursor="SizeNWSE" DragDelta="ResizeSE_DragDelta" Panel.ZIndex="5"/>
        <Thumb x:Name="ResizeE" Grid.Row="1" Width="6"
               HorizontalAlignment="Right" VerticalAlignment="Stretch"
               Cursor="SizeWE" DragDelta="ResizeE_DragDelta" Panel.ZIndex="5"/>
        <Thumb x:Name="ResizeS" Grid.Row="1" Height="6"
               HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
               Cursor="SizeNS" DragDelta="ResizeS_DragDelta" Panel.ZIndex="5"/>

        <!-- Title Bar (Luna caption) -->
        <Border x:Name="TitleBar" Grid.Row="0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                MouseMove="TitleBar_MouseMove"
                MouseLeftButtonUp="TitleBar_MouseLeftButtonUp"
                BorderBrush="#0A246A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="TbLeftImg" Grid.Column="0" Stretch="Fill" IsHitTestVisible="False"/>
                <Image x:Name="TbCenterImg" Grid.Column="1" Stretch="Fill" IsHitTestVisible="False"/>
                <Image x:Name="TbRightImg" Grid.Column="2" Stretch="Fill" IsHitTestVisible="False"/>

                <Grid Grid.Column="0" Grid.ColumnSpan="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="16" Height="16" Margin="6,7,4,7">
                        <Image x:Name="WindowIconImg" Stretch="Uniform"/>
                    </Border>
                    <TextBlock x:Name="TitleText" Grid.Column="1" Text="Window"
                               Foreground="White" FontSize="11" FontFamily="Tahoma"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <StackPanel x:Name="CaptionButtons" Grid.Column="2" Orientation="Horizontal" Margin="0,4,4,4"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Content -->
        <Border x:Name="ContentHost" Grid.Row="1" Background="#ECE9D8">
            <ContentPresenter x:Name="ContentPresenter"/>
        </Border>
    </Grid>
</UserControl>
