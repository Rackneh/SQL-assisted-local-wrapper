<Window x:Class="DoryNative.Views.StudioShell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NVIDIA Nemotron Dory 1.0 4B - Looped LM Studio" Height="900" Width="1440"
        WindowState="Maximized" Background="#0A0D14" Foreground="#F1F5F9"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="StudioBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E283D"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#263347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#263347"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StudioBtnPrimary" TargetType="Button" BasedOn="{StaticResource StudioBtn}">
            <Setter Property="Background" Value="#76B900"/>
            <Setter Property="Foreground" Value="#0A0D14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StudioCard" TargetType="Border">
            <Setter Property="Background" Value="#121824"/>
            <Setter Property="BorderBrush" Value="#263347"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
        </Style>
        <Style x:Key="StudioLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="StudioCombo" TargetType="ComboBox">
            <Setter Property="Background" Value="#0F1520"/>
            <Setter Property="Foreground" Value="#F1F5F9"/>
            <Setter Property="BorderBrush" Value="#263347"/>
            <Setter Property="Padding" Value="6,3"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftCol" Width="290"/>
            <ColumnDefinition x:Name="SessionCol" Width="270"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ================= LEFT SIDEBAR ================= -->
        <Border Grid.Column="0" Background="#0F1520" BorderBrush="#263347" BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <Border DockPanel.Dock="Top" Padding="14,12" BorderBrush="#263347" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🐟" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="NVIDIA Nemotron" FontSize="13" FontWeight="Bold" Foreground="#F1F5F9"/>
                                <TextBlock Text="Dory 1.0 4B" FontSize="17" FontWeight="Bold" Foreground="#76B900"/>
                            </StackPanel>
                        </StackPanel>
                        <Border x:Name="ServerStatusBadge" Background="#1E283D" CornerRadius="10"
                                Padding="8,3" Margin="0,8,0,0" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#64748B"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="StatusText" Text="Connecting..." FontSize="10"
                                           Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- IBA Projects & Workspaces card -->
                        <Border Style="{StaticResource StudioCard}" BorderBrush="#76B900">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="🗄️ IBA Projects &amp; Workspaces" FontSize="12"
                                               FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                                    <Border DockPanel.Dock="Right" Background="#2A3D12" CornerRadius="4"
                                            Padding="5,1">
                                        <TextBlock Text="O(1) SQL" FontSize="9" Foreground="#76B900" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>

                                <CheckBox x:Name="IbaModeToggle" IsChecked="True" Foreground="#F1F5F9"
                                          FontSize="11" FontWeight="Bold" Margin="0,0,0,2">
                                    Use IBA Autonomous SQL Memory
                                </CheckBox>
                                <TextBlock Text="Treats each step as an isolated conversation. Eliminates context bloat and compaction timeouts on local models."
                                           FontSize="9" Foreground="#64748B" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <CheckBox x:Name="VariableNewconvToggle" IsChecked="True" Foreground="#F1F5F9"
                                          FontSize="11" FontWeight="Bold" Margin="0,0,0,8">
                                    ⚡ Variable NewConv Mode
                                </CheckBox>

                                <TextBlock Text="ACTIVE PROJECT" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="WorkspaceSelect" Style="{StaticResource StudioCombo}" Margin="0,0,0,4" SelectionChanged="WorkspaceSelect_SelectionChanged"/>
                                <TextBlock x:Name="WorkspacePath" FontSize="9" Foreground="#00E5FF"
                                           FontFamily="Consolas" TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <TextBlock Text="IBA PROMPT TARGET BUDGET" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                                <UniformGrid x:Name="BudgetGroup" Columns="4" Margin="0,0,0,8">
                                    <Button Content="16K" Tag="16k" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Budget_Click"/>
                                    <Button Content="32K" Tag="32k" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Budget_Click"/>
                                    <Button Content="64K" Tag="64k" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Budget_Click"/>
                                    <Button Content="Auto" Tag="auto" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Budget_Click"/>
                                </UniformGrid>

                                <TextBlock Text="IBA BACKEND (GPU EXCLUSIVE)" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                                <UniformGrid Columns="2" Margin="0,0,0,4">
                                    <Button x:Name="BackendDoryBtn" Content="Dory&#x0a;llama.cpp" Tag="dory"
                                            Style="{StaticResource StudioBtn}" Margin="2" Padding="6,4" FontSize="10" Click="Backend_Click"/>
                                    <Button x:Name="BackendGemmaBtn" Content="Gemma&#x0a;LM Studio" Tag="lmstudio"
                                            Style="{StaticResource StudioBtn}" Margin="2" Padding="6,4" FontSize="10" Click="Backend_Click"/>
                                </UniformGrid>
                                <TextBlock x:Name="BackendStatus" FontSize="9" Foreground="#64748B"
                                           TextWrapping="Wrap" Margin="0,0,0,8"/>

                                <!-- Beige PC power -->
                                <Border x:Name="SidebarPc" Background="#2A2620" CornerRadius="6"
                                        BorderBrush="#5A5245" BorderThickness="1" Padding="8" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="WORKSTATION" FontSize="9" Foreground="#A89878"
                                                   FontWeight="Bold" HorizontalAlignment="Center"/>
                                        <Button x:Name="SidebarPowerBtn" Content="⏻ POWER"
                                                Style="{StaticResource StudioBtn}" Margin="0,4,0,0"
                                                Background="#3A352B" Foreground="#E8D8B0"
                                                Click="SidebarPower_Click"/>
                                        <Ellipse x:Name="SidebarPowerLed" Width="8" Height="8" Fill="#5A5245"
                                                 HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <UniformGrid Columns="3">
                                    <Button Content="📌 Pin Rule" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="9" Click="PinRule_Click"/>
                                    <Button Content="🗺️ Map" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="9" Click="CodeMap_Click"/>
                                    <Button Content="📋 Log" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="9" Click="TaskLog_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Recurrent Loop Engine card -->
                        <Border Style="{StaticResource StudioCard}">
                            <StackPanel>
                                <TextBlock Text="🔄 Recurrent Loop Engine" FontSize="12" FontWeight="Bold"
                                           Foreground="#F1F5F9" Margin="0,0,0,8"/>
                                <TextBlock Text="LOOP COUNT" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                                <UniformGrid x:Name="LoopGroup" Columns="4" Margin="0,0,0,8">
                                    <Button Content="1" Tag="1" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Loop_Click"/>
                                    <Button Content="2" Tag="2" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Loop_Click"/>
                                    <Button Content="4" Tag="4" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Loop_Click"/>
                                    <Button Content="8" Tag="8" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="Loop_Click"/>
                                </UniformGrid>
                                <TextBlock Text="KV CACHE MODE" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                                <UniformGrid x:Name="KvGroup" Columns="2">
                                    <Button Content="per_loop" Tag="per_loop" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="KvMode_Click"/>
                                    <Button Content="last_loop" Tag="last_loop" Style="{StaticResource StudioBtn}" Margin="2" Padding="4,4" FontSize="10" Click="KvMode_Click"/>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar footer -->
                <Border DockPanel.Dock="Bottom" Padding="10" BorderBrush="#263347" BorderThickness="0,1,0,0">
                    <UniformGrid Columns="2">
                        <Button Content="🗑️ Clear Chat" Style="{StaticResource StudioBtn}" Margin="0,0,4,0" FontSize="10" Click="ClearChat_Click"/>
                        <Button Content="📥 Export" Style="{StaticResource StudioBtn}" Margin="4,0,0,0" FontSize="10" Click="ExportChat_Click"/>
                    </UniformGrid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================= MIDDLE SESSION SIDEBAR ================= -->
        <Border Grid.Column="1" x:Name="SessionSidebar" Background="#121824"
                BorderBrush="#263347" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="10,8" BorderBrush="#263347" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock Text="🗂️ Workspaces &amp; Sessions" FontSize="11" FontWeight="Bold"
                                   Foreground="#F1F5F9" VerticalAlignment="Center"/>
                        <Button DockPanel.Dock="Right" Content="◀" Width="22" Height="22"
                                Style="{StaticResource StudioBtn}" Padding="0" FontSize="10"
                                Click="ToggleSessionSidebar_Click"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="ACTIVE PROJECT" Style="{StaticResource StudioLabel}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="SessionWsSelect" Style="{StaticResource StudioCombo}" Margin="0,0,0,4" SelectionChanged="SessionWsSelect_SelectionChanged"/>
                        <TextBlock x:Name="SessionWsPath" FontSize="9" Foreground="#64748B"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Active project card -->
                        <Border x:Name="ActiveProjectCard" Background="#182030" CornerRadius="8"
                                BorderBrush="#76B900" BorderThickness="1" Padding="10" Margin="0,0,0,10">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="ActiveProjectName" Text="No Project Selected"
                                               FontSize="11" FontWeight="Bold" Foreground="#F1F5F9"
                                               TextWrapping="Wrap"/>
                                    <Border x:Name="PcStatusPill" DockPanel.Dock="Right"
                                            Background="#3A1D1D" CornerRadius="8" Padding="6,1">
                                        <TextBlock x:Name="PcStatusText" Text="OFFLINE" FontSize="9"
                                                   Foreground="#FF6B6B" FontWeight="Bold"/>
                                    </Border>
                                </DockPanel>
                                <Border x:Name="ActivePcBody" Background="#2A2620" CornerRadius="6"
                                        BorderBrush="#5A5245" BorderThickness="1" Padding="8" Margin="0,8,0,0">
                                    <StackPanel>
                                        <Button x:Name="ActivePowerBtn" Content="⏻ POWER"
                                                Style="{StaticResource StudioBtn}" Background="#3A352B"
                                                Foreground="#E8D8B0" Click="ActivePower_Click"/>
                                        <TextBlock x:Name="ActivePcHint" Text="Click to boot workstation"
                                                   FontSize="9" Foreground="#A89878" TextAlignment="Center"
                                                   Margin="0,4,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="AVAILABLE WORKSTATIONS" Style="{StaticResource StudioLabel}" Margin="0,0,0,6"/>
                        <ItemsControl x:Name="OtherProjectsGrid">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="104" Background="#182030" CornerRadius="8"
                                            BorderBrush="#263347" BorderThickness="1" Padding="8"
                                            Margin="0,0,8,8" Cursor="Hand"
                                            MouseLeftButtonDown="OtherProject_Click">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="Bold"
                                                       Foreground="#F1F5F9" TextWrapping="Wrap"/>
                                            <Border Height="34" Background="#2A2620" CornerRadius="4"
                                                    BorderBrush="#5A5245" BorderThickness="1" Margin="0,4,0,0">
                                                <TextBlock Text="⏻" FontSize="14" Foreground="#A89878"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                        <Border.Tag>
                                            <Binding Path="Path"/>
                                        </Border.Tag>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <Border DockPanel.Dock="Bottom" Padding="10" BorderBrush="#263347" BorderThickness="0,1,0,0">
                    <UniformGrid Columns="3">
                        <Button Content="📌 Pin" Style="{StaticResource StudioBtn}" Margin="0,0,3,0" FontSize="9" Click="PinRule_Click"/>
                        <Button Content="🗺️ Map" Style="{StaticResource StudioBtn}" Margin="2,0" FontSize="9" Click="CodeMap_Click"/>
                        <Button Content="📋 Tasks" Style="{StaticResource StudioBtn}" Margin="3,0,0,0" FontSize="9" Click="TaskLog_Click"/>
                    </UniformGrid>
                </Border>
            </DockPanel>
        </Border>

        <!-- ================= MAIN CHAT WORKSPACE ================= -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Top bar -->
            <Border Grid.Row="0" Background="#121824" BorderBrush="#263347" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <Button Content="☰" Width="30" Height="26" Style="{StaticResource StudioBtn}" Padding="0" Click="ToggleLeftSidebar_Click"/>
                        <Button Content="🗂️" Width="30" Height="26" Style="{StaticResource StudioBtn}" Padding="0" Margin="4,0,0,0" Click="ToggleSessionSidebar_Click"/>
                        <Border Background="#1E283D" CornerRadius="6" Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Model" FontSize="9" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBlock x:Name="ModelBadge" Text="Dory1.0-4B-Q5_K_M" FontSize="11" FontWeight="Bold" Foreground="#76B900" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="ChipProject" Background="#1E283D" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChipProjectText" Text="📁 Project: ..." FontSize="10" Foreground="#94A3B8"/>
                        </Border>
                        <Border Background="#1E283D" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChipSessionText" Text="💬 Session: ..." FontSize="10" Foreground="#94A3B8"/>
                        </Border>
                        <Border Background="#2A3D12" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="⚡ IBA SQL Mode" FontSize="10" FontWeight="Bold" Foreground="#76B900"/>
                        </Border>
                        <Border Background="#1E283D" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChipLoopsText" Text="2 Loops" FontSize="10" Foreground="#94A3B8"/>
                        </Border>
                        <Border Background="#3A2A14" CornerRadius="10" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ChipGpuText" Text="🎮 GPU" FontSize="10" Foreground="#FFA502" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Background="#1E283D" CornerRadius="10" Padding="8,3" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="ActivityDot" Width="8" Height="8" Fill="#64748B"
                                         VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock x:Name="ActivityText" Text="Idle" FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Button Content="🖥️ Console" Style="{StaticResource StudioBtn}" Padding="8,3" FontSize="10" Click="ToggleConsole_Click"/>
                        <Border Background="#1E283D" CornerRadius="6" Padding="8,3" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TokenSpeedStat" Text="-- tokens/s" FontSize="10" Foreground="#00E5FF" FontFamily="Consolas"/>
                        </Border>
                        <Border Background="#1E283D" CornerRadius="6" Padding="8,3" Margin="6,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ServerPortStat" Text="Port: --" FontSize="10" Foreground="#94A3B8" FontFamily="Consolas"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Simulator host / off state -->
            <Grid Grid.Row="1" Background="#000000">
                <Grid x:Name="SimHost">
                    <!-- Bottom layer: boot/install/logon stages, then the XP desktop -->
                    <ContentControl x:Name="StageHost" Background="#000000"/>
                    <!-- Top layer: in-sim dialog windows (xp chrome) -->
                    <Canvas x:Name="DialogLayer"/>
                </Grid>
                <Border x:Name="PcOffOverlay" Background="#0A0D14">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Workstation is powered off" FontSize="16" FontWeight="Bold"
                                   Foreground="#94A3B8" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                        <TextBlock Text="Select a project and press ⏻ POWER to boot the Windows XP simulator."
                                   FontSize="11" Foreground="#64748B" HorizontalAlignment="Center" TextWrapping="Wrap"
                                   MaxWidth="360" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Console drawer -->
            <Border x:Name="ConsoleDrawer" Grid.Row="2" Background="#0F1520"
                    BorderBrush="#263347" BorderThickness="0,1,0,0" MaxHeight="220">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="8,4" BorderBrush="#263347" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="DrawerPulseDot" Width="8" Height="8" Fill="#76B900"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="DrawerStatusTitle" Text="Engine Idle (Ready for OpenCode &amp; Chat)"
                                           FontSize="10" FontWeight="Bold" Foreground="#F1F5F9" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="🗑️ Clear" Style="{StaticResource StudioBtn}" Padding="6,2" FontSize="9" Margin="0,0,4,0" Click="DrawerClear_Click"/>
                                <Button Content="📋 Copy" Style="{StaticResource StudioBtn}" Padding="6,2" FontSize="9" Margin="0,0,4,0" Click="DrawerCopy_Click"/>
                                <Button x:Name="DrawerAutoscrollBtn" Content="📜 Auto-Scroll" Style="{StaticResource StudioBtn}" Padding="6,2" FontSize="9" Click="DrawerAutoscroll_Click"/>
                                <Button Content="▲" Width="26" Style="{StaticResource StudioBtn}" Padding="0" FontSize="9" Margin="6,0,0,0" Click="ToggleConsole_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer x:Name="DrawerBody" VerticalScrollBarVisibility="Auto" MaxHeight="170">
                        <StackPanel x:Name="TerminalLines" Margin="8,4"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
