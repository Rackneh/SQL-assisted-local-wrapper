<UserControl x:Class="DoryNative.Views.NotepadWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="400" Width="550">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Border Grid.Row="0" Background="#ECE9D8" BorderBrush="#ACA899" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="2,2">
                <Button Content="File" Width="45" Height="22" Margin="1,0" FontSize="10" FontFamily="Tahoma"
                        Click="FileMenu_Click" Tag="file"/>
                <Button Content="Edit" Width="45" Height="22" Margin="1,0" FontSize="10" FontFamily="Tahoma"
                        Click="FileMenu_Click" Tag="edit"/>
                <Button Content="Format" Width="55" Height="22" Margin="1,0" FontSize="10" FontFamily="Tahoma"
                        Click="FileMenu_Click" Tag="format"/>
            </StackPanel>
        </Border>

        <!-- Text editor -->
        <TextBox Grid.Row="1" x:Name="Editor" AcceptsReturn="True" AcceptsTab="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="12" Padding="8,6" BorderThickness="0"
                 TextChanged="Editor_TextChanged" SpellCheck.IsEnabled="False"/>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#ECE9D8" BorderBrush="#ACA899" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Margin="6,2">
                <TextBlock x:Name="StatusText" Text="Ln 1, Col 1" FontSize="10" Foreground="#444444"/>
                <TextBlock x:Name="ModifiedIndicator" Text="" FontSize="10" Foreground="Red" Margin="20,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
