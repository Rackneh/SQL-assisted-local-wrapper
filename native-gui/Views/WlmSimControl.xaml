<UserControl x:Class="DoryNative.Views.WlmSimControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F1F4F8">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Contact / session list -->
        <Border Grid.Column="0" Background="#EEF2F7" BorderBrush="#C7D3E0" BorderThickness="0,0,1,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Background="#0054E3" Padding="10,8">
                    <TextBlock Text="Windows Live Messenger" Foreground="White" FontSize="13"
                               FontWeight="Bold" FontFamily="Tahoma"/>
                </Border>
                <ListBox x:Name="ContactList" Background="Transparent" BorderThickness="0"
                         FontFamily="Tahoma" FontSize="12"
                         SelectionChanged="ContactList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="4,3">
                                <Border Width="34" Height="34" CornerRadius="4" Background="#DDE5EE"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Image Source="{Binding AvatarImage}" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="#667"/>
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Bottom" Text="Sessions sync with the IBA backend."
                           FontSize="10" Foreground="#778" Margin="8,4" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Chat area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0054E3" Padding="10,7">
                <DockPanel>
                    <TextBlock x:Name="ChatTitle" Text="Select a session" Foreground="White"
                               FontSize="13" FontWeight="SemiBold" FontFamily="Tahoma"/>
                    <TextBlock x:Name="ChatSubtitle" Text="" Foreground="#CFE0FF" FontSize="10"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="MessagesScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="MessagesPanel" Margin="10,8"/>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#DDE5EE" BorderBrush="#B9C6D4" BorderThickness="0,1,0,0" Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" FontFamily="Tahoma" FontSize="12" Padding="6,4"
                             AcceptsReturn="False" KeyDown="InputBox_KeyDown"/>
                    <Button Grid.Column="1" Content="Send" Width="70" Margin="8,0,0,0"
                            Background="#0054E3" Foreground="White" BorderThickness="0"
                            FontFamily="Tahoma" FontWeight="Bold" Click="Send_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
